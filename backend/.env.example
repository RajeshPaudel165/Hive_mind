HIVE_STATE_PATH=data/hive_state.json
HIVE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Webapp agent creation starts OpenClaw and one local telegram_bot.py worker per agent by default.

# Runtime placement. Use local for MVP/dev. Use dedalus to provision one isolated
# Dedalus Machine per user_id before creating that user's agents.
HIVE_RUNTIME_MODE=local
DEDALUS_API_KEY=
DEDALUS_ORG_ID=
DEDALUS_MACHINE_VCPU=1
DEDALUS_MACHINE_MEMORY_MIB=2048
DEDALUS_MACHINE_STORAGE_GIB=10

# OpenClaw local gateway. Start OpenClaw with the HTTP chat-completions endpoint enabled.
OPENCLAW_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_HEALTH_URL=http://127.0.0.1:18789/
OPENCLAW_CHAT_MODEL=openclaw
OPENCLAW_PROVIDER_MODEL=google/gemini-3-flash-preview
OPENCLAW_TIMEOUT_SECONDS=45

# Default LLM provider for OpenClaw.
GEMINI_API_KEY=
# GOOGLE_API_KEY= can also be used if your local Gemini/OpenClaw setup expects it.

# Only set this if your OpenClaw gateway uses bearer auth.
# OPENCLAW_API_KEY=

TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_SECONDS=30
HIVE_SAVE_ASSISTANT_REPLIES=true

# Run telegram_bot.py for one configured agent.
# HIVE_AGENT_ID=AGENT-1234ABCD

# Scheduled proactive pulse delivery.
HIVE_PULSE_INTERVAL_SECONDS=3600
HIVE_PULSE_LOOP_SLEEP_SECONDS=30

# MemPalace local memory mirror/search.
HIVE_MEMPALACE_ENABLED=true
HIVE_MEMPALACE_PATH=data/mempalace
HIVE_MEMPALACE_AGENT=hive_brain
